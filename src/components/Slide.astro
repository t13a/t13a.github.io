---
// One carousel item. `requiresScript` hides slides that are meaningless without JavaScript,
// like a live clock.
interface Props {
  label: string;
  requiresScript?: boolean;
}

const { label, requiresScript = false } = Astro.props;
---

<li
  class="slide"
  role="group"
  aria-roledescription="slide"
  aria-label={label}
  data-requires-script={requiresScript || undefined}
  hidden={requiresScript}
>
  <slot />
</li>
