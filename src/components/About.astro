---
import '@fontsource/caveat/latin-600.css';
import { GITHUB_LOGIN } from '../config';
---

<footer class="about">
  <a href={`https://github.com/${GITHUB_LOGIN}`}>github.com/{GITHUB_LOGIN}</a>
  <p>There's a way.</p>
</footer>

<style>
  /* The line is a note written after the button; wide screens tuck it into the corner on the left. */
  .about {
    display: flex;
    flex-direction: row-reverse;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 16px 24px;
    padding: 28px var(--gutter);
  }

  /* The closing line, kept short after the slides and scribbled by hand */
  p {
    flex: 1 1 320px;
    margin: 0;
    font-family: 'Caveat', var(--font);
    font-size: 32px;
    font-weight: 600;
    line-height: 1.1;
    transform: rotate(-2deg);
    transform-origin: left;
  }

  a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 20px;
    border-radius: 999px;
    background: var(--ink);
    color: var(--card);
    font-size: 15px;
    font-weight: 600;
    text-decoration: none;
  }

  a:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 3px;
  }

  /* Drawn in outline on paper, where backgrounds may not print */
  @media print {
    a {
      border: 1px solid;
      background: none;
      color: var(--ink);
    }
  }

  /* Stacked on narrow screens, where the line sits at the foot of the card with the same room
     above and below itself */
  @media (max-width: 640px) {
    .about {
      flex-direction: column;
      gap: 0;
      padding-bottom: 0;
      text-align: center;
    }

    p {
      flex: none;
      padding-block: 48px;
      font-size: 30px;
      transform-origin: center;
    }
  }
</style>
