---
import '@fontsource/caveat/latin-600.css';
import { GITHUB_LOGIN } from '../config';
---

<footer class="about">
  <p>There's a way.</p>
  <a href={`https://github.com/${GITHUB_LOGIN}`}>github.com/{GITHUB_LOGIN}</a>
</footer>

<style>
  .about {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 16px 24px;
    padding: 28px var(--gutter);
  }

  /* The closing line, kept short after the slides and scribbled by hand */
  p {
    flex: 1 1 320px;
    margin: 0;
    font-family: 'Caveat', var(--font);
    font-size: 32px;
    font-weight: 600;
    line-height: 1.1;
    transform: rotate(-2deg);
    transform-origin: left;
  }

  a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 20px;
    border-radius: 999px;
    background: var(--ink);
    color: var(--card);
    font-size: 15px;
    font-weight: 600;
    text-decoration: none;
  }

  a:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 3px;
  }

  /* Stacked on narrow screens, with plenty of room above and below the line */
  @media (max-width: 640px) {
    .about {
      flex-direction: column;
      row-gap: 32px;
      padding-block: 52px 40px;
      text-align: center;
    }

    p {
      flex: none;
      font-size: 30px;
      transform-origin: center;
    }
  }
</style>
