---
// The shadow is a blurred layer behind the sheet rather than box-shadow, whose tiled
// rendering can leave hairlines when mobile Firefox zooms.
---

<div class="card">
  <article class="sheet">
    <slot />
  </article>
</div>

<style>
  .card {
    position: relative;
    width: 100%;
    max-width: 760px;
    margin: auto 0;
  }

  .card::before {
    content: '';
    position: absolute;
    inset: 0;
    translate: 0 8px;
    border-radius: 14px;
    background: rgb(0 0 0 / 0.55);
    filter: blur(10px);
  }

  .sheet {
    position: relative;
    background: var(--card);
    border-radius: 14px;
  }

  @media print {
    .card::before {
      display: none;
    }
  }

  /* Full width and flush with the top of the screen */
  @media (max-width: 640px) {
    .card {
      margin-top: 0;
    }

    .card::before,
    .sheet {
      border-radius: 0;
    }
  }
</style>
