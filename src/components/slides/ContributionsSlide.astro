---
import { github } from '../../lib/data';

// The profile's contribution calendar, one cell per day, seven rows per week column.
const { start, total, levels } = github.contributions.lastYear;
const first = Date.parse(`${start}T00:00:00Z`);
const monthName = new Intl.DateTimeFormat('en-US', { month: 'short', timeZone: 'UTC' });
const cells = [...levels].map((level, i) => ({ level, col: Math.floor(i / 7) }));
const weeks = Math.ceil(levels.length / 7);

// Label a column where a month starts, skipping labels that would crowd each other.
const months: { name: string; col: number }[] = [];
for (let i = 0; i < levels.length; i++) {
  const day = new Date(first + i * 86_400_000);
  const col = Math.floor(i / 7);
  if (day.getUTCDate() === 1 && col <= weeks - 3 && col - (months.at(-1)?.col ?? -9) >= 3) {
    months.push({ name: monthName.format(day), col });
  }
}
---

<div class="contributions">
  <div class="calendar" aria-hidden="true">
    <div class="months">
      {months.map((m) => <span style={`--col: ${m.col}`}>{m.name}</span>)}
    </div>
    <div class="days">
      {cells.map((c) => <i data-level={c.level} data-enter="sprout" style={`--col: ${c.col}`} />)}
    </div>
  </div>
  <p class="total" data-enter="right">
    <strong>{total.toLocaleString('en-US')}</strong>
    <span>contributions <br />in the last year</span>
  </p>
</div>

<style>
  .contributions {
    display: flex;
    align-items: center;
    gap: 32px;
  }

  /* On narrow screens the oldest weeks are clipped from the left. */
  .calendar {
    flex: 0 1 auto;
    min-width: 0;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 6px;
  }

  .months {
    position: relative;
    width: calc(var(--weeks) * 9px - 2px);
    height: 12px;
    --weeks: 53;
  }

  .months span {
    position: absolute;
    left: calc(var(--col) * 9px);
    font-size: 10px;
    line-height: 12px;
    color: var(--ink-3);
  }

  .days {
    display: grid;
    grid-auto-flow: column;
    grid-template-rows: repeat(7, 7px);
    grid-auto-columns: 7px;
    gap: 2px;
  }

  .days i {
    border-radius: 1.5px;
    background: var(--grass-0);
    --delay: calc(80ms + var(--col) * 14ms);
  }

  .days [data-level='1'] { background: var(--grass-1); }
  .days [data-level='2'] { background: var(--grass-2); }
  .days [data-level='3'] { background: var(--grass-3); }
  .days [data-level='4'] { background: var(--grass-4); }

  .total {
    flex: 1 0 auto;
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 6px;
    text-align: right;
  }

  strong {
    font-size: 52px;
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
  }

  .total span {
    font-size: 15px;
    line-height: 1.35;
    color: var(--ink-2);
  }

  @media (max-width: 640px) {
    .contributions {
      flex-direction: column-reverse;
      align-items: stretch;
      gap: 16px;
    }

    .total {
      flex: none;
      flex-direction: row;
      justify-content: center;
      align-items: baseline;
      gap: 10px;
      text-align: left;
    }

    strong {
      font-size: 44px;
    }

    .total br {
      display: none;
    }
  }
</style>
