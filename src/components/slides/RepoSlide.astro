---
import { Icon } from 'astro-icon/components';
import { GITHUB_LOGIN } from '../../config';
import type { Repo } from '../../lib/github';

interface Props {
  repo: Repo;
}

const { repo } = Astro.props;
const name = repo.nameWithOwner.replace(`${GITHUB_LOGIN}/`, '');
const description = repo.description.replaceAll('**', '');
const count = (n: number) => (n >= 1000 ? `${(n / 1000).toFixed(1)}k` : String(n));
const committed =
  repo.committedAt &&
  new Intl.DateTimeFormat('en-US', { dateStyle: 'medium', timeZone: 'Asia/Tokyo' }).format(new Date(repo.committedAt));

// Icons are inlined (is:inline) because the ticker removes unpicked slides, which would take
// shared sprite symbols with them.
---

<a class="repo" href={repo.url} data-enter="left">
  <div class="body">
    <p class="eyebrow">Featured repository</p>
    <p class="name"><Icon is:inline name="octicon:repo-16" title="Repository" /><span>{name}</span></p>
    {description && <p class="description">{description}</p>}
  </div>
  <p class="meta">
    <span><Icon is:inline name="octicon:star-16" title="Stars" />{count(repo.stars)}</span>
    <span><Icon is:inline name="octicon:repo-forked-16" title="Forks" />{count(repo.forks)}</span>
    {committed && <span>Last commit {committed}</span>}
  </p>
</a>

<style>
  /* The repository fills the slide so every one is laid out the same way. The text on top
     wraps and fades out at the bottom when it runs long; the stats stay on one line at the
     bottom and fade out on the right. Each fade covers padding, so only overflow reaches it. */
  .repo {
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
    color: inherit;
    text-decoration: none;
  }

  .repo:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 6px;
    border-radius: 4px;
  }

  p {
    margin: 0;
  }

  .body {
    flex: 1 1 0;
    min-height: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding-bottom: 16px;
    overflow: hidden;
    mask-image: linear-gradient(to bottom, #000 calc(100% - 16px), transparent);
  }

  .eyebrow {
    margin-bottom: 6px;
  }

  .name {
    font-size: 28px;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.02em;
    overflow-wrap: anywhere;
  }

  .name svg {
    display: inline-block;
    width: 24px;
    height: 24px;
    margin-right: 8px;
    vertical-align: -0.12em;
    color: var(--accent);
  }

  .repo:hover .name span {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 5px;
  }

  .description {
    font-size: 15px;
    line-height: 1.4;
    color: var(--ink-2);
  }

  .meta {
    flex: none;
    display: flex;
    gap: 18px;
    padding-right: 32px;
    overflow: hidden;
    white-space: nowrap;
    font-size: 13px;
    line-height: 1.4;
    color: var(--ink-3);
    mask-image: linear-gradient(to right, #000 calc(100% - 32px), transparent);
  }

  .meta span {
    flex: none;
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }

  .meta svg {
    width: 14px;
    height: 14px;
  }

  @media (max-width: 640px) {
    .name {
      font-size: 24px;
    }

    .name svg {
      width: 20px;
      height: 20px;
    }
  }
</style>
