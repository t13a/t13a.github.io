---
import { Icon } from 'astro-icon/components';

// What the slide says for each part of a Tokyo day. The hours live in the script below.
const states = [
  { key: 'sleep', icon: 'lucide:bed', text: 'Asleep. The servers are not.' },
  { key: 'morning', icon: 'lucide:coffee', text: 'Starting the day slowly.' },
  { key: 'work', icon: 'lucide:briefcase', text: 'At work, keeping things running.' },
  { key: 'lunch', icon: 'lucide:utensils', text: 'Out for lunch.' },
  { key: 'dinner', icon: 'lucide:utensils', text: 'Having dinner.' },
  { key: 'homelab', icon: 'lucide:server', text: 'Probably tinkering in the homelab.' },
];
---

<tokyo-clock class="tokyo" data-enter="rise">
  <p class="eyebrow" data-date></p>
  <p class="time" data-time></p>
  <p class="status">
    {
      states.map((s) => (
        <span data-state={s.key} hidden>
          <Icon name={s.icon} aria-hidden="true" data-enter="pop" />
          {s.text}
        </span>
      ))
    }
  </p>
</tokyo-clock>

<style>
  .tokyo {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    text-align: center;
  }

  .time {
    margin: 0;
    font-size: 60px;
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
  }

  .status {
    margin: 4px 0 0;
    font-size: 16px;
    line-height: 1.4;
    color: var(--ink-2);
  }

  .status span:not([hidden]) {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .status svg {
    width: 20px;
    height: 20px;
    color: var(--accent);
  }
</style>

<script>
  type State = 'sleep' | 'morning' | 'work' | 'lunch' | 'dinner' | 'homelab';

  function stateAt(hour: number, weekend: boolean): State {
    if (hour < 7) return 'sleep';
    if (hour < 9) return 'morning';
    if (hour === 12) return 'lunch';
    if (hour === 19) return 'dinner';
    if (hour < 18 && !weekend) return 'work';
    return 'homelab';
  }

  const format = new Intl.DateTimeFormat('en-US', {
    timeZone: 'Asia/Tokyo',
    weekday: 'long',
    month: 'long',
    day: 'numeric',
    hour: '2-digit',
    minute: '2-digit',
    second: '2-digit',
    hourCycle: 'h23',
  });

  class TokyoClock extends HTMLElement {
    #timer = 0;

    connectedCallback() {
      this.#tick();
    }

    disconnectedCallback() {
      clearTimeout(this.#timer);
    }

    // Redraw just after each second turns over.
    #tick() {
      this.#update();
      this.#timer = window.setTimeout(() => this.#tick(), 1000 - (Date.now() % 1000) + 20);
    }

    #update() {
      const p = Object.fromEntries(format.formatToParts(new Date()).map(({ type, value }) => [type, value]));
      const state = stateAt(Number(p.hour), p.weekday === 'Saturday' || p.weekday === 'Sunday');
      this.querySelector('[data-date]')!.textContent = `${p.weekday}, ${p.month} ${p.day}`;
      this.querySelector('[data-time]')!.textContent = `${p.hour}:${p.minute}:${p.second}`;
      for (const el of this.querySelectorAll<HTMLElement>('[data-state]')) el.hidden = el.dataset.state !== state;
    }
  }

  customElements.define('tokyo-clock', TokyoClock);
</script>
