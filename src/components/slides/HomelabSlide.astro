---
// The closing slide: engineering as a hobby, drawn as an iceberg. It is widest at the waterline
// and tapers both ways, longer below: the homelab is the bulk under the water, angular and drawn
// in dashed hidden lines down to the usual jagged point, and the tip that surfaces is what goes
// to GitHub.
---

<div class="homelab">
  <p class="eyebrow" data-enter="left">Homelab and open source</p>
  <p class="slogan" data-enter="left">Off the clock, still building.</p>
  <p class="description" data-enter="left">Most of it lives in my homelab. The tip surfaces on GitHub as open source.</p>
  <svg class="iceberg" viewBox="0 0 160 128" aria-hidden="true" data-enter="rise">
    <path d="M4 44q6-3 12 0t12 0h6M124 44h8q6-3 12 0t12 0" />
    <path class="tip" d="M34 44 58 28l8 4 18-26 14 18 8-4 18 24" />
    <path d="M84 6l-4 20 8 18" />
    <path class="under" d="M34 44 40 74 54 86 67 114 87 124 90 116 117 91 124 44" />
  </svg>
</div>

<style>
  /* Text on the left and the iceberg on the right, beside the slogan only on narrow screens */
  .homelab {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas:
      'eyebrow art'
      'slogan art'
      'description art';
    align-content: center;
    align-items: center;
    gap: 4px 24px;
  }

  p {
    margin: 0;
  }

  .eyebrow {
    grid-area: eyebrow;
    margin-bottom: 6px;
  }

  .slogan {
    grid-area: slogan;
    font-size: 32px;
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  .description {
    grid-area: description;
    font-size: 15px;
    line-height: 1.4;
    color: var(--ink-2);
  }

  .iceberg {
    grid-area: art;
    width: 160px;
    height: auto;
    fill: none;
    stroke: var(--accent);
    stroke-width: 1.75;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* Lines keep their weight at the smaller size */
  .iceberg path {
    vector-effect: non-scaling-stroke;
  }

  /* The tip is lit like the card; the rest is drawn in hidden lines. */
  .tip {
    fill: var(--card);
  }

  .under {
    stroke-dasharray: 4 3;
  }

  @media (max-width: 640px) {
    .homelab {
      grid-template-areas:
        'eyebrow art'
        'slogan art'
        'description description';
      column-gap: 16px;
    }

    .slogan {
      font-size: 24px;
    }

    .description {
      margin-top: 6px;
    }

    .iceberg {
      width: 104px;
    }
  }
</style>
