---
// The closing slide: engineering as a hobby, drawn as an iceberg. The homelab is the bulk under
// the water, in dashed hidden lines; the tip that surfaces is what goes to GitHub.
---

<div class="homelab">
  <p class="eyebrow" data-enter="left">Homelab and open source</p>
  <p class="slogan" data-enter="left">Off the clock, still building.</p>
  <p class="description" data-enter="left">Most of it lives in my homelab. The tip surfaces on GitHub as open source.</p>
  <svg class="iceberg" viewBox="0 0 160 128" aria-hidden="true" data-enter="rise">
    <path d="M6 44q6-3 12 0t12 0t12 0t12 0h4M104 44h2q6-3 12 0t12 0t12 0t12 0" />
    <path class="tip" d="M58 44 68 28l8 4 10-22 12 20 6 14" />
    <path d="M86 10l-2 18 6 16" />
    <path class="under" d="M58 44 38 62l-8 26 20 26 40 8 34-22 8-32-28-24M90 44 70 84l20 38M70 84l62-16" />
  </svg>
</div>

<style>
  /* Text on the left and the iceberg on the right, beside the slogan only on narrow screens */
  .homelab {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas:
      'eyebrow art'
      'slogan art'
      'description art';
    align-content: center;
    align-items: center;
    gap: 4px 24px;
  }

  p {
    margin: 0;
  }

  .eyebrow {
    grid-area: eyebrow;
    margin-bottom: 6px;
  }

  .slogan {
    grid-area: slogan;
    font-size: 32px;
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  .description {
    grid-area: description;
    font-size: 15px;
    line-height: 1.4;
    color: var(--ink-2);
  }

  .iceberg {
    grid-area: art;
    width: 160px;
    height: auto;
    fill: none;
    stroke: var(--accent);
    stroke-width: 1.75;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* Lines keep their weight at the smaller size */
  .iceberg path {
    vector-effect: non-scaling-stroke;
  }

  /* The tip is lit like the card; the rest is drawn in hidden lines. */
  .tip {
    fill: var(--card);
  }

  .under {
    stroke-dasharray: 5 4;
  }

  @media (max-width: 640px) {
    .homelab {
      grid-template-areas:
        'eyebrow art'
        'slogan art'
        'description description';
      column-gap: 16px;
    }

    .slogan {
      font-size: 24px;
    }

    .description {
      margin-top: 6px;
    }

    .iceberg {
      width: 104px;
    }
  }
</style>
