---
import Iceberg from '../../assets/iceberg.svg';

// The closing slide: engineering as a hobby, drawn as an iceberg. It is widest at the waterline
// and tapers both ways, longer below: the homelab is the bulk under the water, angular and drawn
// in dashed hidden lines down to the usual jagged point, and the tip that surfaces is what goes
// to GitHub. The drawing is a file of its own with its colours and lines, so it can be touched
// up in any SVG editor.
---

<div class="homelab">
  <p class="eyebrow" data-enter="left">Homelab and open source</p>
  <p class="slogan" data-enter="left">Off the clock, still building.</p>
  <p class="description" data-enter="left">Most of it lives in my homelab. The tip surfaces on GitHub as open source.</p>
  <Iceberg class="iceberg" aria-hidden="true" data-enter="rise" />
</div>

<style>
  /* Text on the left and the iceberg on the right, beside the slogan only on narrow screens */
  .homelab {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas:
      'eyebrow art'
      'slogan art'
      'description art';
    align-content: center;
    align-items: center;
    gap: 4px 24px;
  }

  p {
    margin: 0;
  }

  .eyebrow {
    grid-area: eyebrow;
    margin-bottom: 6px;
  }

  .slogan {
    grid-area: slogan;
    font-size: 32px;
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  .description {
    grid-area: description;
    font-size: 15px;
    line-height: 1.4;
    color: var(--ink-2);
  }

  .iceberg {
    grid-area: art;
    width: 160px;
    height: auto;
  }

  /* Lines keep their weight at the smaller size */
  .iceberg :global(*) {
    vector-effect: non-scaling-stroke;
  }

  @media (max-width: 640px) {
    .homelab {
      grid-template-areas:
        'eyebrow art'
        'slogan art'
        'description description';
      column-gap: 16px;
    }

    .slogan {
      font-size: 24px;
    }

    .description {
      margin-top: 6px;
    }

    .iceberg {
      width: 104px;
    }
  }
</style>
