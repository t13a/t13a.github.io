---
// What every page stands on: the contour ground around the card and the copyright under it.
---

<div class="page" style="--contour: url(/contour.svg)">
  <slot />
  <p class="copyright">© {new Date().getFullYear()} Tatsuya Kitagawa</p>
</div>

<style>
  .page {
    box-sizing: border-box;
    min-height: 100vh;
    min-height: 100lvh;
    padding: 48px 16px 32px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 48px;
  }

  /* Contour lines over a darker centre and a faintly lit top-left corner, held to the screen
     rather than the page, so the ground stays put when the page grows */
  .page::before {
    content: '';
    position: fixed;
    top: 0;
    right: 0;
    left: 0;
    z-index: -1;
    height: 100vh;
    height: 100lvh;
    background:
      var(--contour) center / cover no-repeat,
      radial-gradient(ellipse 75% 85% at 80% 76%, rgb(0 0 0 / 0.35), transparent 75%),
      radial-gradient(ellipse 95% 95% at 0% 0%, rgb(255 255 255 / 0.07), transparent 72%),
      var(--ground);
  }

  @media (max-width: 640px) {
    .page {
      padding: 0 0 24px;
      gap: 24px;
    }
  }

  .copyright {
    margin: 0;
    font-size: 13px;
    letter-spacing: 0.02em;
    color: var(--caption);
  }

  /* Paper stays white, with only the card and the copyright under it */
  @media print {
    .page {
      min-height: 0;
      padding: 0;
    }

    .page::before {
      display: none;
    }

    .copyright {
      color: var(--ink-3);
    }
  }
</style>
