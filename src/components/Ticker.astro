---
import { CAROUSEL } from '../config';

// Without JavaScript this is a CSS scroll-snap carousel of every slide. The script turns it into
// an auto-advancing ticker that shows the slides one at a time, in the order they are written,
// with a progress bar. To read at one's own pace, Show all lays every slide out in a list, keeping
// the current one where the ticker was; a segment of the bar does the same for its own slide.
---

<live-ticker style={`--slide-duration: ${CAROUSEL.slideSeconds}s`}>
  <section class="ticker" aria-roledescription="carousel" aria-label="Live feed">
    <ul class="track">
      <slot />
    </ul>
    <div class="controls" hidden>
      <ol class="progress" aria-label="Slides"></ol>
      <button class="all" type="button">Show all</button>
    </div>
  </section>
</live-ticker>

<style>
  live-ticker {
    display: block;
    --progress: var(--accent-bright);
  }

  .ticker {
    position: relative;
  }

  .track {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    overscroll-behavior-x: contain;
    scrollbar-width: none;
  }

  /* Each slide carries the strip, so slides can cover one another like cards. */
  .track > :global(.slide) {
    flex: 0 0 100%;
    box-sizing: border-box;
    min-width: 0;
    padding: 24px var(--gutter);
    background: var(--strip);
    display: flex;
    flex-direction: column;
    justify-content: center;
    scroll-snap-align: start;
  }

  .track > :global(.slide[hidden]) {
    display: none;
  }

  /* Dots under the slides where the browser can draw CSS carousels by itself */
  @supports selector(::scroll-marker) {
    .track {
      scroll-marker-group: after;
    }

    .track::scroll-marker-group {
      background: var(--strip);
      display: flex;
      justify-content: center;
      gap: 4px;
      padding-bottom: 12px;
    }

    .track > :global(.slide)::scroll-marker {
      content: '';
      width: 8px;
      height: 8px;
      margin: 8px;
      border-radius: 50%;
      background: var(--rule);
    }

    .track > :global(.slide)::scroll-marker:target-current {
      background: var(--progress);
    }
  }

  /* Enhanced, on screen: all slides share one grid cell, so the ticker keeps the height of the
     tallest one as it turns, however long a translation makes it. */
  @media screen {
    live-ticker[data-enhanced] .track {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      overflow: visible;
      scroll-marker-group: none;
    }

    live-ticker[data-enhanced] .track > :global(.slide) {
      grid-area: 1 / 1;
      padding-bottom: 52px;
      visibility: hidden;
    }

    live-ticker[data-enhanced] .track > :global(.slide[data-active]) {
      visibility: visible;
    }
  }

  /* Expanded: one slide under another, each as tall as its own text */
  live-ticker[data-expanded] .track > :global(.slide) {
    grid-area: auto;
    padding-bottom: 24px;
    visibility: visible;
  }

  live-ticker[data-expanded] .track > :global(.slide + .slide) {
    border-top: 1px solid var(--rule);
  }

  /* Focused only by the script, to carry the keyboard on from the slide picked */
  live-ticker .track > :global(.slide:focus) {
    outline: none;
  }

  .controls {
    position: absolute;
    right: calc(var(--gutter) - 12px);
    bottom: 0;
    left: var(--gutter);
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .controls[hidden] {
    display: none;
  }

  .progress {
    flex: 1;
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    gap: 6px;
  }

  .progress :global(li) {
    flex: 1;
    min-width: 0;
  }

  /* Each segment is a button as tall as Show all, around a thin bar. */
  .progress :global(button) {
    display: flex;
    align-items: center;
    width: 100%;
    height: 44px;
    padding: 0;
    border: 0;
    border-radius: 4px;
    background: transparent;
    cursor: pointer;
  }

  .progress :global(button:focus-visible) {
    outline: 2px solid var(--ink);
  }

  .progress :global(.bar) {
    flex: 1;
    height: 3px;
    border-radius: 2px;
    background: var(--rule);
    overflow: hidden;
    transition: height 120ms;
  }

  /* The current segment stands out even before it starts filling, as when rotation is paused. */
  .progress :global(:is(button:hover, [aria-current]) .bar) {
    background: color-mix(in srgb, var(--ink) 28%, transparent);
  }

  .progress :global(button:hover .bar) {
    height: 5px;
  }

  .progress :global(.fill) {
    display: block;
    height: 100%;
    background: var(--progress);
    transform: scaleX(0);
    transform-origin: left;
  }

  .progress :global([data-done] .fill) {
    transform: none;
  }

  .progress :global([aria-current] .fill) {
    animation: fill var(--slide-duration) linear forwards;
  }

  live-ticker:is([data-paused], [data-held]) .progress :global(.fill) {
    animation-play-state: paused;
  }

  @keyframes fill {
    to {
      transform: none;
    }
  }

  /* As tall as the segments, with its label in line with the text above */
  .all {
    flex: none;
    height: 44px;
    padding: 0 12px;
    border: 0;
    border-radius: 8px;
    background: transparent;
    color: var(--ink-2);
    font: inherit;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
  }

  .all:hover {
    color: var(--ink);
  }

  .all:focus-visible {
    outline: 2px solid var(--ink);
  }

  /* On paper the slides are laid out as when expanded, whatever the ticker is showing, with no
     slide split across pages */
  @media print {
    .track {
      display: block;
      overflow: visible;
    }

    .track > :global(.slide) {
      break-inside: avoid;
    }

    .track > :global(.slide + .slide) {
      border-top: 1px solid var(--rule);
    }

    .controls {
      display: none;
    }
  }
</style>

<style is:global>
  /* How slide contents enter. Slides mark elements with data-enter; the ticker restarts these
     animations each time a slide becomes active by toggling data-active. */
  live-ticker[data-enhanced] .slide[data-active] [data-enter] {
    animation: 560ms var(--ease-out) var(--delay, 40ms) both;
  }

  live-ticker[data-enhanced] .slide[data-active] [data-enter='rise'] { animation-name: enter-rise; }
  live-ticker[data-enhanced] .slide[data-active] [data-enter='left'] { animation-name: enter-left; }
  live-ticker[data-enhanced] .slide[data-active] [data-enter='right'] { animation-name: enter-right; --delay: 200ms; }
  live-ticker[data-enhanced] .slide[data-active] [data-enter='pop'] { animation-name: enter-pop; animation-timing-function: var(--ease-bounce); --delay: 120ms; }
  live-ticker[data-enhanced] .slide[data-active] [data-enter='sprout'] { animation-name: enter-sprout; animation-duration: 360ms; animation-timing-function: var(--ease-bounce); }

  @keyframes enter-rise { from { opacity: 0; transform: translateY(18px); } }
  @keyframes enter-left { from { opacity: 0; transform: translateX(-32px); } }
  @keyframes enter-right { from { opacity: 0; transform: translateX(32px); } }
  @keyframes enter-pop { from { opacity: 0; transform: scale(0.55) rotate(-12deg); } }
  @keyframes enter-sprout { from { opacity: 0; transform: scale(0.2); } }

  @media (prefers-reduced-motion: reduce), print {
    [data-enter] {
      animation: none !important;
    }
  }
</style>

<script>
  import { CAROUSEL } from '../config';

  const DURATION = CAROUSEL.slideSeconds * 1000;

  class LiveTicker extends HTMLElement {
    #slides: HTMLElement[] = [];
    #track!: HTMLElement;
    #segments: HTMLButtonElement[] = [];
    #index = 0;
    #timer = 0;
    #remaining = DURATION;
    #startedAt = 0;

    connectedCallback() {
      this.#track = this.querySelector<HTMLElement>('.track')!;
      this.#slides = [...this.#track.querySelectorAll<HTMLElement>(':scope > .slide')];
      this.#slides.forEach((s, i) => {
        s.hidden = false;
        s.setAttribute('aria-label', `${i + 1} of ${this.#slides.length}: ${s.getAttribute('aria-label')}`);
      });

      // One segment per slide: <li><button><span class="bar"><span class="fill">
      const progress = this.querySelector('.progress')!;
      this.#segments = this.#slides.map((s, i) => {
        const button = document.createElement('button');
        button.type = 'button';
        button.setAttribute('aria-label', s.getAttribute('aria-label')!);
        button.addEventListener('click', () => this.#expand(i));
        const bar = button.appendChild(document.createElement('span'));
        bar.className = 'bar';
        bar.appendChild(document.createElement('span')).className = 'fill';
        progress.appendChild(document.createElement('li')).appendChild(button);
        return button;
      });

      this.querySelector('.all')!.addEventListener('click', () => this.#expand(this.#index));

      // Without motion the ticker stays on its first slide.
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) this.toggleAttribute('data-paused', true);

      // Hold still while the pointer or keyboard focus is inside, so links can be followed.
      const section = this.querySelector<HTMLElement>('.ticker')!;
      const hold = (on: boolean) => {
        this.toggleAttribute('data-held', on);
        this.#sync();
      };
      section.addEventListener('pointerenter', () => hold(true));
      section.addEventListener('pointerleave', () => hold(section.contains(document.activeElement)));
      section.addEventListener('focusin', () => hold(true));
      section.addEventListener('focusout', (e) => hold(section.contains(e.relatedTarget as Node) || section.matches(':hover')));

      this.querySelector<HTMLElement>('.controls')!.hidden = false;
      this.toggleAttribute('data-enhanced', true);
      this.#show(0);
    }

    disconnectedCallback() {
      clearTimeout(this.#timer);
    }

    #show(next: number) {
      this.#index = next % this.#slides.length;
      this.#slides.forEach((s, i) => s.toggleAttribute('data-active', i === this.#index));
      this.#segments.forEach((button, i) => {
        button.toggleAttribute('data-done', i < this.#index);
        if (i === this.#index) button.setAttribute('aria-current', 'true');
        else button.removeAttribute('aria-current');
      });
      this.#remaining = DURATION;
      this.#startedAt = 0;
      this.#sync();
    }

    // Lays every slide out for good. The picked one stays where the ticker showed it while the
    // rest open up around it, and takes the focus so the keyboard carries on from there. It stays
    // active too, so one that was not showing yet enters as it would in the ticker.
    #expand(index: number) {
      const slide = this.#slides[index];
      const card = this.closest<HTMLElement>('.card');
      const top = slide.getBoundingClientRect().top;
      const was = card?.getBoundingClientRect();
      clearTimeout(this.#timer);
      this.toggleAttribute('data-expanded', true);
      this.#slides.forEach((s) => s.toggleAttribute('data-active', s === slide));
      this.querySelector<HTMLElement>('.controls')!.hidden = true;
      this.querySelector('.ticker')!.removeAttribute('aria-roledescription');
      window.scrollBy(0, slide.getBoundingClientRect().top - top);
      slide.tabIndex = -1;
      slide.focus({ preventScroll: true });
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;

      // Then the stack falls apart. The card the ticker sits in moves as one piece from where it
      // was to where the longer page leaves it, while each slide spreads out from under the picked
      // one, the nearest on top. The picked one keeps still, unless no scrolling could hold it, as
      // at the top of a centred card, where it rides up with the card.
      const now = card?.getBoundingClientRect();
      const dx = now && was ? now.left - was.left : 0;
      const dy = now && was ? now.top - was.top : 0;
      const tops = this.#slides.map((s) => s.getBoundingClientRect().top);
      const timing = { duration: 560, easing: getComputedStyle(this).getPropertyValue('--ease-out').trim() };
      card?.animate({ translate: [`${-dx}px ${-dy}px`, '0 0'] }, timing);
      this.#slides.forEach((s, i) => {
        const z = this.#slides.length - Math.abs(i - index);
        s.animate({ translate: [`0 ${top - tops[i] + dy}px`, '0 0'], zIndex: [z, z] }, timing);
      });
    }

    // The timer counts down the current slide's remaining time and stops while paused, held or
    // expanded; the progress bar is only its picture, paused by the same attributes in CSS.
    // Screen readers are not told of the turns: no visitor makes them, so they would only interrupt.
    #sync() {
      if (this.#startedAt) this.#remaining -= performance.now() - this.#startedAt;
      this.#startedAt = 0;
      clearTimeout(this.#timer);
      if (this.matches('[data-paused], [data-held], [data-expanded]')) return;
      this.#startedAt = performance.now();
      this.#timer = window.setTimeout(() => this.#show(this.#index + 1), Math.max(0, this.#remaining));
    }
  }

  customElements.define('live-ticker', LiveTicker);
</script>
