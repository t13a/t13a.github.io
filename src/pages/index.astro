---
import About from '../components/About.astro';
import Card from '../components/Card.astro';
import Profile from '../components/Profile.astro';
import Slide from '../components/Slide.astro';
import Ticker from '../components/Ticker.astro';
import ContributionsSlide from '../components/slides/ContributionsSlide.astro';
import RepoSlide from '../components/slides/RepoSlide.astro';
import SummarySlide from '../components/slides/SummarySlide.astro';
import TokyoSlide from '../components/slides/TokyoSlide.astro';
import Base from '../layouts/Base.astro';
import { CAREER_START_YEAR } from '../config';
import { github } from '../lib/data';

// Pinned repositories form one pool; popular and recent ones that are not pinned form the other.
const { pinned, popular, recent } = github.featured;
const pinnedNames = new Set(pinned.map((r) => r.nameWithOwner));
const others = [...new Map([...popular, ...recent].map((r) => [r.nameWithOwner, r])).values()].filter(
  (r) => !pinnedNames.has(r.nameWithOwner),
);
---

<Base
  title="Tatsuya Kitagawa"
  description={`Senior software engineer in Tokyo with ${new Date().getFullYear() - CAREER_START_YEAR} years of Dev and Ops experience. Self-hosting and open source at home.`}
>
  <div class="page" style="--contour: url(/contour.svg)">
    <Card>
      <Profile />
      <Ticker>
        <Slide label="Tokyo, now" requiresScript><TokyoSlide /></Slide>
        {pinned.map((repo) => <Slide label="Featured repository" group="pinned"><RepoSlide repo={repo} /></Slide>)}
        {others.map((repo) => <Slide label="Featured repository" group="other"><RepoSlide repo={repo} /></Slide>)}
        <Slide label="Contributions"><ContributionsSlide /></Slide>
        <Slide label="Since 2013 on GitHub"><SummarySlide /></Slide>
      </Ticker>
      <About />
    </Card>
    <p class="copyright">© {new Date().getFullYear()} Tatsuya Kitagawa</p>
  </div>
</Base>

<style>
  /* Contour lines over a dark heartwood around their centre and a light top-left corner */
  .page {
    box-sizing: border-box;
    min-height: 100vh;
    min-height: 100lvh;
    padding: 48px 16px 32px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 48px;
    background:
      var(--contour) center / cover no-repeat,
      radial-gradient(ellipse 75% 85% at 80% 76%, rgb(44 52 35 / 0.12), transparent 75%),
      radial-gradient(ellipse 95% 95% at 0% 0%, rgb(255 255 255 / 0.6), transparent 72%),
      var(--ground);
  }

  @media (max-width: 640px) {
    .page {
      padding: 0 0 24px;
      gap: 24px;
    }
  }

  .copyright {
    margin: 0;
    font-size: 13px;
    letter-spacing: 0.02em;
    color: var(--caption);
  }
</style>
