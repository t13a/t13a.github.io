---
import { Icon } from 'astro-icon/components';
import About from '../components/About.astro';
import Card from '../components/Card.astro';
import Profile from '../components/Profile.astro';
import Slide from '../components/Slide.astro';
import Ticker from '../components/Ticker.astro';
import FeatureSlide from '../components/slides/FeatureSlide.astro';
import HomelabSlide from '../components/slides/HomelabSlide.astro';
import Base from '../layouts/Base.astro';
import { CAREER_START_YEAR } from '../config';
---

<Base
  title="Tatsuya Kitagawa"
  description={`Senior software engineer in Tokyo with ${new Date().getFullYear() - CAREER_START_YEAR} years in Dev and Ops: application development, infrastructure and driving projects.`}
>
  <div class="page" style="--contour: url(/contour.svg)">
    <Card>
      <Profile />
      <Ticker>
        <Slide label="How I work: full stack, full cycle">
          <FeatureSlide eyebrow="How I work" icon="lucide:infinity" title="Full stack, full cycle">
            I learned the trade as the only engineer on many small projects at once. Performance, security, the bug
            that won't reproduce: all mine to handle, so I automated the rest.
            <a slot="meta" href="https://www.credly.com/users/t13a/badges/credly">
              <Icon name="lucide:award" aria-hidden="true" />Passed CKA and CKS in 2022
            </a>
          </FeatureSlide>
        </Slide>
        <Slide label="Open source contribution">
          <FeatureSlide
            eyebrow="Open source contribution"
            icon="octicon:git-pull-request-16"
            title="awslabs/git-secrets"
            href="https://github.com/awslabs/git-secrets/pull/67"
          >
            A serious bug let credentials slip past AWS Labs' secret scanner: it checked only the first of several
            files. Found in my homelab, fixed upstream.
            <span slot="meta"><Icon name="octicon:git-merge-16" aria-hidden="true" />Merged Aug 10, 2018</span>
          </FeatureSlide>
        </Slide>
        <Slide label="Business continuity: “Stay home” in two weeks">
          <FeatureSlide eyebrow="Business continuity" icon="lucide:virus-off" title="“Stay home” in two weeks">
            When COVID-19 hit, a PoC on a closed network kept us on site. I proposed a secure tunnel spanning the
            existing networks and got everyone working from home.
            <span slot="meta" class="tag">Apache Guacamole</span>
            <span slot="meta" class="tag">SSH reverse port forwarding</span>
            <span slot="meta" class="tag">AWS Session Manager</span>
          </FeatureSlide>
        </Slide>
        <Slide label="Technical research: bit rot, measured">
          <FeatureSlide eyebrow="Technical research" icon="lucide:hard-drive" title="Bit rot, measured">
            RAID can't fix data that silently rots on a healthy disk. I found no speed comparison of the Linux stacks
            that can, so I benchmarked 19 setups with fio and published the report.
            <a slot="meta" href="https://github.com/t13a/dm-integrity-benchmarks">
              <Icon name="octicon:repo-16" aria-hidden="true" />t13a/dm-integrity-benchmarks
            </a>
          </FeatureSlide>
        </Slide>
        <Slide label="Latest project: let the AI rehearse first">
          <FeatureSlide eyebrow="Latest project" icon="lucide:bot" title="Let the AI rehearse first">
            An AI agent organizes piles of large files by moving only symlinks; the real ones follow once I approve
            its plan in git. Linux and git already had every piece, so the code stays small.
            <a slot="meta" href="https://github.com/t13a/rehearse">
              <Icon name="octicon:repo-16" aria-hidden="true" />t13a/rehearse
            </a>
          </FeatureSlide>
        </Slide>
        <Slide label="Growing the team: zero to web app in ten days">
          <FeatureSlide eyebrow="Growing the team" icon="lucide:sprout" title="Zero to web app in ten days">
            Our infrastructure team had to take on a web app. I wrote a chat app as a commit-by-commit course, and
            teammates who had never coded for work built their own in ten days.
            <a slot="meta" href="https://github.com/t13a/quacker">
              <Icon name="octicon:repo-16" aria-hidden="true" />t13a/quacker
            </a>
          </FeatureSlide>
        </Slide>
        <Slide label="Homelab and open source"><HomelabSlide /></Slide>
      </Ticker>
      <About />
    </Card>
    <p class="copyright">© {new Date().getFullYear()} Tatsuya Kitagawa</p>
  </div>
</Base>

<style>
  /* Contour lines over a darker centre and a faintly lit top-left corner */
  .page {
    box-sizing: border-box;
    min-height: 100vh;
    min-height: 100lvh;
    padding: 48px 16px 32px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 48px;
    background:
      var(--contour) center / cover no-repeat,
      radial-gradient(ellipse 75% 85% at 80% 76%, rgb(0 0 0 / 0.35), transparent 75%),
      radial-gradient(ellipse 95% 95% at 0% 0%, rgb(255 255 255 / 0.07), transparent 72%),
      var(--ground);
  }

  @media (max-width: 640px) {
    .page {
      padding: 0 0 24px;
      gap: 24px;
    }
  }

  .copyright {
    margin: 0;
    font-size: 13px;
    letter-spacing: 0.02em;
    color: var(--caption);
  }
</style>
