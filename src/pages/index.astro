---
import About from '../components/About.astro';
import Card from '../components/Card.astro';
import Profile from '../components/Profile.astro';
import Slide from '../components/Slide.astro';
import Ticker from '../components/Ticker.astro';
import RepoSlide from '../components/slides/RepoSlide.astro';
import TokyoSlide from '../components/slides/TokyoSlide.astro';
import Base from '../layouts/Base.astro';
import { CAREER_START_YEAR } from '../config';
import { github } from '../lib/data';

// Only pinned repositories are featured; counts like contributions and stars are left out.
const { pinned } = github.featured;
---

<Base
  title="Tatsuya Kitagawa"
  description={`Senior software engineer in Tokyo with ${new Date().getFullYear() - CAREER_START_YEAR} years of Dev and Ops experience. Self-hosting and open source at home.`}
>
  <div class="page" style="--contour: url(/contour.svg)">
    <Card>
      <Profile />
      <Ticker>
        <Slide label="Tokyo, now" requiresScript><TokyoSlide /></Slide>
        {pinned.map((repo) => <Slide label="Featured repository" group="pinned"><RepoSlide repo={repo} /></Slide>)}
      </Ticker>
      <About />
    </Card>
    <p class="copyright">© {new Date().getFullYear()} Tatsuya Kitagawa</p>
  </div>
</Base>

<style>
  /* Contour lines over a darker centre and a faintly lit top-left corner */
  .page {
    box-sizing: border-box;
    min-height: 100vh;
    min-height: 100lvh;
    padding: 48px 16px 32px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 48px;
    background:
      var(--contour) center / cover no-repeat,
      radial-gradient(ellipse 75% 85% at 80% 76%, rgb(0 0 0 / 0.35), transparent 75%),
      radial-gradient(ellipse 95% 95% at 0% 0%, rgb(255 255 255 / 0.07), transparent 72%),
      var(--ground);
  }

  @media (max-width: 640px) {
    .page {
      padding: 0 0 24px;
      gap: 24px;
    }
  }

  .copyright {
    margin: 0;
    font-size: 13px;
    letter-spacing: 0.02em;
    color: var(--caption);
  }
</style>
