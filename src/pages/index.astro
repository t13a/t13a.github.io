---
import { Icon } from 'astro-icon/components';
import About from '../components/About.astro';
import Card from '../components/Card.astro';
import Profile from '../components/Profile.astro';
import Slide from '../components/Slide.astro';
import Ticker from '../components/Ticker.astro';
import FeatureSlide from '../components/slides/FeatureSlide.astro';
import HomelabSlide from '../components/slides/HomelabSlide.astro';
import ProjectSlide from '../components/slides/ProjectSlide.astro';
import Base from '../layouts/Base.astro';
import { CAREER_START_YEAR } from '../config';
import { github } from '../lib/data';

// Two of my own repositories: the most starred, and the latest pushed for a sign of what I am on
// now. The latest skips the most starred when they are the same one.
const { popular, recent } = github.featured;
const starred = popular.toSorted((a, b) => b.stars - a.stars)[0];
const latest = recent.find((r) => r.nameWithOwner !== starred?.nameWithOwner);
---

<Base
  title="Tatsuya Kitagawa"
  description={`Senior software engineer in Tokyo with ${new Date().getFullYear() - CAREER_START_YEAR} years in Dev and Ops: application development, infrastructure and driving projects.`}
>
  <div class="page" style="--contour: url(/contour.svg)">
    <Card>
      <Profile />
      <Ticker>
        <Slide label="Application development: beyond the happy path">
          <FeatureSlide eyebrow="Application development" icon="lucide:route" title="Beyond the happy path">
            Performance, reliability, the bug that won't reproduce. I take them on from requirements to operations,
            and build frameworks that speed the whole team up.
            <span slot="meta" class="tag">TypeScript</span>
            <span slot="meta" class="tag">Python</span>
            <span slot="meta" class="tag">Java</span>
            <span slot="meta" class="tag">DDD</span>
          </FeatureSlide>
        </Slide>
        <Slide label="Infrastructure: ground to build on">
          <FeatureSlide eyebrow="Infrastructure" icon="lucide:layers" title="Ground to build on">
            Networks, servers and Linux, up through containers, Kubernetes and infrastructure as code. I lead the
            build and leave nothing in the team's way.
            <a slot="meta" href="https://www.credly.com/users/t13a/badges/credly">
              <Icon name="lucide:award" aria-hidden="true" />Passed CKA and CKS in 2022
            </a>
          </FeatureSlide>
        </Slide>
        <Slide label="Driving projects: seeing around corners">
          <FeatureSlide eyebrow="Driving projects" icon="lucide:binoculars" title="Seeing around corners">
            Risk or opportunity, I spot it early, propose the way forward and see it through. Beside the
            decision-makers, I plan, lead and report, and grow the people around me.
            <span slot="meta" class="tag">Technical research</span>
            <span slot="meta" class="tag">PoC</span>
            <span slot="meta" class="tag">Postmortems</span>
            <span slot="meta" class="tag">Study sessions</span>
          </FeatureSlide>
        </Slide>
        <Slide label="Track record: “Stay home” in two weeks">
          <FeatureSlide eyebrow="Track record" icon="lucide:virus-off" title="“Stay home” in two weeks">
            When COVID-19 hit, a PoC on a closed network kept us on site. I proposed a secure tunnel spanning the
            existing networks and got everyone working from home.
            <span slot="meta" class="tag">Apache Guacamole</span>
            <span slot="meta" class="tag">SSH reverse port forwarding</span>
            <span slot="meta" class="tag">AWS Session Manager</span>
          </FeatureSlide>
        </Slide>
        <Slide label="Open source contribution">
          <FeatureSlide
            eyebrow="Open source contribution"
            icon="octicon:git-pull-request-16"
            title="awslabs/git-secrets"
            href="https://github.com/awslabs/git-secrets/pull/67"
          >
            Found and fixed a bug in the secret scanner from AWS Labs: given several files, it checked only the
            first, letting credentials in the rest slip into commits.
            <span slot="meta"><Icon name="octicon:git-merge-16" aria-hidden="true" />Merged Aug 10, 2018</span>
          </FeatureSlide>
        </Slide>
        {
          starred && (
            <Slide label="Most starred repository">
              <ProjectSlide eyebrow="Most starred repository" repo={starred} />
            </Slide>
          )
        }
        {
          latest && (
            <Slide label="Latest push">
              <ProjectSlide eyebrow="Latest push" repo={latest} />
            </Slide>
          )
        }
        <Slide label="Homelab and open source"><HomelabSlide /></Slide>
      </Ticker>
      <About />
    </Card>
    <p class="copyright">© {new Date().getFullYear()} Tatsuya Kitagawa</p>
  </div>
</Base>

<style>
  /* Contour lines over a darker centre and a faintly lit top-left corner */
  .page {
    box-sizing: border-box;
    min-height: 100vh;
    min-height: 100lvh;
    padding: 48px 16px 32px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 48px;
    background:
      var(--contour) center / cover no-repeat,
      radial-gradient(ellipse 75% 85% at 80% 76%, rgb(0 0 0 / 0.35), transparent 75%),
      radial-gradient(ellipse 95% 95% at 0% 0%, rgb(255 255 255 / 0.07), transparent 72%),
      var(--ground);
  }

  @media (max-width: 640px) {
    .page {
      padding: 0 0 24px;
      gap: 24px;
    }
  }

  .copyright {
    margin: 0;
    font-size: 13px;
    letter-spacing: 0.02em;
    color: var(--caption);
  }
</style>
