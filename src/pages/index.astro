---
import { Icon } from 'astro-icon/components';
import About from '../components/About.astro';
import Card from '../components/Card.astro';
import Page from '../components/Page.astro';
import Profile from '../components/Profile.astro';
import Slide from '../components/Slide.astro';
import Ticker from '../components/Ticker.astro';
import FeatureSlide from '../components/slides/FeatureSlide.astro';
import HomelabSlide from '../components/slides/HomelabSlide.astro';
import Base from '../layouts/Base.astro';
import { CAREER_START_YEAR } from '../config';
---

<Base
  title="Tatsuya Kitagawa"
  description={`Senior software engineer in Tokyo with ${new Date().getFullYear() - CAREER_START_YEAR} years in Dev and Ops: full stack from apps to infrastructure, full cycle from requirements to support.`}
>
  <Page>
    <Card>
      <Profile />
      <Ticker>
        <Slide label="How I work: full stack, full cycle">
          <FeatureSlide eyebrow="How I work" icon="lucide:infinity" title="Full stack, full cycle">
            I learned the trade as the only engineer on many small app projects at once. Performance, security, the
            bug that won't reproduce: all mine to handle, so I built tools for the rest.
            <a slot="meta" href="https://www.credly.com/users/t13a/badges/credly">
              <Icon name="lucide:award" aria-hidden="true" />Passed CKA and CKS in 2022
            </a>
          </FeatureSlide>
        </Slide>
        <Slide label="Open source contribution: one fix for all">
          <FeatureSlide eyebrow="Open source contribution" icon="lucide:shield-check" title="One fix for all">
            A serious bug let credentials slip past AWS Labs' secret scanner: it checked only the first of several
            files. Found in my homelab, fixed upstream.
            <a slot="meta" href="https://github.com/awslabs/git-secrets/pull/67">
              <Icon name="octicon:git-pull-request-16" aria-hidden="true" />awslabs/git-secrets
            </a>
            <span slot="meta">Merged Aug 10, 2018</span>
          </FeatureSlide>
        </Slide>
        <Slide label="Business continuity: “Stay home” in two weeks">
          <FeatureSlide eyebrow="Business continuity" icon="lucide:virus-off" title="“Stay home” in two weeks">
            When COVID-19 hit, a PoC on a closed network kept us on site. I proposed a secure tunnel spanning the
            existing networks and got everyone working from home.
            <span slot="meta" class="tag">Apache Guacamole</span>
            <span slot="meta" class="tag">AWS Session Manager</span>
          </FeatureSlide>
        </Slide>
        <Slide label="Growing the team: one commit at a time">
          <FeatureSlide eyebrow="Growing the team" icon="lucide:sprout" title="One commit at a time">
            Our infrastructure team had to take on a web app. I wrote a chat app as a commit-by-commit course: a
            ten-day intro to web development for teammates who had never coded for work.
            <a slot="meta" href="https://github.com/t13a/quacker">
              <Icon name="octicon:repo-16" aria-hidden="true" />t13a/quacker
            </a>
            <span slot="meta" class="tag">TypeScript</span>
            <span slot="meta" class="tag">Node.js</span>
            <span slot="meta" class="tag">Frontend</span>
          </FeatureSlide>
        </Slide>
        <Slide label="Latest project: no code, no bugs, AI or not">
          <FeatureSlide eyebrow="Latest project" icon="lucide:bot" title="No code, no bugs, AI or not">
            How do you let an AI agent organize piles of large files safely? Not with more code: it only moves
            symlinks, Linux permissions fence it in, and I approve the plan in git.
            <a slot="meta" href="https://github.com/t13a/rehearse">
              <Icon name="octicon:repo-16" aria-hidden="true" />t13a/rehearse
            </a>
            <span slot="meta" class="tag">Python</span>
            <span slot="meta" class="tag">Unix philosophy</span>
          </FeatureSlide>
        </Slide>
        <Slide label="Technical research: bit rot, measured">
          <FeatureSlide eyebrow="Technical research" icon="lucide:hard-drive" title="Bit rot, measured">
            RAID can't fix data that silently rots on a healthy disk. I found no speed comparison of the Linux stacks
            that can, so I benchmarked 19 setups with fio and published the report.
            <a slot="meta" href="https://github.com/t13a/dm-integrity-benchmarks">
              <Icon name="octicon:repo-16" aria-hidden="true" />t13a/dm-integrity-benchmarks
            </a>
            <span slot="meta" class="tag">R</span>
            <span slot="meta" class="tag">Linux</span>
            <span slot="meta" class="tag">fio</span>
          </FeatureSlide>
        </Slide>
        <Slide label="Homelab and open source"><HomelabSlide /></Slide>
      </Ticker>
      <About />
    </Card>
  </Page>
</Base>
