---
import { Icon } from 'astro-icon/components';
import About from '../components/About.astro';
import Card from '../components/Card.astro';
import Profile from '../components/Profile.astro';
import Slide from '../components/Slide.astro';
import Ticker from '../components/Ticker.astro';
import FeatureSlide from '../components/slides/FeatureSlide.astro';
import ProjectSlide from '../components/slides/ProjectSlide.astro';
import TokyoSlide from '../components/slides/TokyoSlide.astro';
import Base from '../layouts/Base.astro';
import { CAREER_START_YEAR, GITHUB_LOGIN } from '../config';
import { github } from '../lib/data';

// Only my own pinned repositories are featured; counts like contributions and stars are left out.
const projects = github.featured.pinned.filter((r) => r.nameWithOwner.startsWith(`${GITHUB_LOGIN}/`));
---

<Base
  title="Tatsuya Kitagawa"
  description={`Senior software engineer in Tokyo with ${new Date().getFullYear() - CAREER_START_YEAR} years of Dev and Ops experience. Self-hosting and open source at home.`}
>
  <div class="page" style="--contour: url(/contour.svg)">
    <Card>
      <Profile />
      <Ticker>
        <Slide label="Tokyo, now" requiresScript><TokyoSlide /></Slide>
        <Slide label="What I do: architecture">
          <FeatureSlide eyebrow="What I do" icon="lucide:drafting-compass" title="Architecture">
            Shaping systems before the first line is written: drawing the boundaries, weighing the trade-offs and
            leaving a path the team can follow.
          </FeatureSlide>
        </Slide>
        <Slide label="What I do: platform engineering">
          <FeatureSlide eyebrow="What I do" icon="lucide:layers" title="Platform engineering">
            Paving the road for product teams with Kubernetes, CI/CD and infrastructure as code, so they ship
            without fighting the plumbing.
            <span slot="meta">Passed CKA and CKS in 2022</span>
          </FeatureSlide>
        </Slide>
        <Slide label="What I do: technical research">
          <FeatureSlide eyebrow="What I do" icon="lucide:flask-conical" title="Technical research">
            Settling the unknowns early with prototypes, benchmarks and write-ups that turn into decisions.
          </FeatureSlide>
        </Slide>
        <Slide label="Open source contribution">
          <FeatureSlide
            eyebrow="Open source contribution"
            icon="octicon:git-pull-request-16"
            title="awslabs/git-secrets"
            href="https://github.com/awslabs/git-secrets/pull/67"
          >
            Found and fixed a bug in the secret scanner from AWS Labs: given several files, it checked only the
            first, letting credentials in the rest slip into commits.
            <span slot="meta"><Icon is:inline name="octicon:git-merge-16" aria-hidden="true" />Merged Aug 10, 2018</span>
          </FeatureSlide>
        </Slide>
        {projects.map((repo) => <Slide label="Featured repository" group="pinned"><ProjectSlide repo={repo} /></Slide>)}
      </Ticker>
      <About />
    </Card>
    <p class="copyright">© {new Date().getFullYear()} Tatsuya Kitagawa</p>
  </div>
</Base>

<style>
  /* Contour lines over a darker centre and a faintly lit top-left corner */
  .page {
    box-sizing: border-box;
    min-height: 100vh;
    min-height: 100lvh;
    padding: 48px 16px 32px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 48px;
    background:
      var(--contour) center / cover no-repeat,
      radial-gradient(ellipse 75% 85% at 80% 76%, rgb(0 0 0 / 0.35), transparent 75%),
      radial-gradient(ellipse 95% 95% at 0% 0%, rgb(255 255 255 / 0.07), transparent 72%),
      var(--ground);
  }

  @media (max-width: 640px) {
    .page {
      padding: 0 0 24px;
      gap: 24px;
    }
  }

  .copyright {
    margin: 0;
    font-size: 13px;
    letter-spacing: 0.02em;
    color: var(--caption);
  }
</style>
